# Firebase Web SDK config
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public site URL (used by sitemap, OG tags, canonical links)
NUXT_PUBLIC_SITE_URL=

# Firebase App Check — reCAPTCHA v3 site key (Firebase console → App Check).
# Leave empty to disable App Check (not recommended for production).
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

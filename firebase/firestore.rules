rules_version = '2';

// SYM-GR-0001, SYM-GR-0004, SYM-GR-0019: least privilege authz enforced here.
// Admin access requires a custom claim `admin == true` (set via Firebase Admin SDK,
// not from any client). Authentication alone is NOT sufficient to write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // Products: public read, admin-only write.
    // Invariant: doc ID equals the slug (guaranteed by client via setDoc(id=slug)).
    // We enforce slug regex AND slug == id at the rule level so the URL is
    // deterministic and collisions are impossible (SYM-GR-0003, SYM-GR-0004).
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9-]{1,120}$')
        && request.resource.data.slug == id
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 100000
        && request.resource.data.category in ['bagues', 'colliers', 'bracelets', 'boucles']
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 10
        && request.resource.data.featured is bool;
      allow delete: if isAdmin();
    }

    // Brand config: public read, admin-only write.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages: unauthenticated create with strict validation
    // (SYM-GR-0003, SYM-GR-0014 for retention is out-of-scope here).
    // Read/update restricted to admins.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'content', 'createdAt', 'read'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'content', 'createdAt', 'read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 2000
        && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }

    // Orders: phase 2 (Stripe). For now only admins can touch them.
    match /orders/{id} {
      allow read, write: if isAdmin();
    }
  }
}
